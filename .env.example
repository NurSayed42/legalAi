# ─── Bangladesh Legal AI v3 — Environment Variables ────────
# এই file টা .env নামে save করো, কখনো git এ push করবে না

# LLM Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Gemini model override (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-2.5-flash-lite

# Database
CHROMA_DB_PATH=./legal_chroma_db

# Optional
LOG_LEVEL=INFO
