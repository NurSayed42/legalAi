# ─── Bangladesh Legal AI v3 — Environment Variables ────────
# এই file টা .env নামে save করো, কখনো git এ push করবে না

# LLM Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Model override (default: gemini-3.5-flash / openai/gpt-oss-120b)
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# Database (API আর build script দুটোই এটা পড়ে)
CHROMA_DB_PATH=./legal_chroma_db
