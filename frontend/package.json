{
  "name": "legalai-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"qa/**/*.mjs\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"qa/**/*.mjs\" \"*.{ts,js,json}\"",
    "qa:contrast": "node qa/contrast.mjs",
    "qa:unit": "node --test src/lib/*.test.ts",
    "qa:baseline": "node qa/baseline.mjs",
    "qa:after": "node qa/after.mjs",
    "qa:parity": "node qa/parity.mjs",
    "qa:axe": "node qa/axe.mjs",
    "qa:lighthouse": "node qa/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/hind-siliguri": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-serif-bengali": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "framer-motion": "14.9.1",
    "lucide-react": "1.69.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6"
  }
}
